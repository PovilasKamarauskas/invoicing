# Copy to .env ON THE DEBIAN SERVER. Keep the existing local .env unchanged.
# Replace the hostname with your Cloudflare public hostname; no path/trailing slash.
APP_ORIGIN=https://invoices.example.com
APP_ENV=production
COOKIE_SECURE=true
REGISTRATION_ENABLED=false
TRUST_CLOUDFLARE_PROXY=true

# Supply the existing Gmail app password privately, never commit a filled .env.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

BACKUP_HOST_DIR=./backups/automatic
BACKUP_RETENTION=14
BACKUP_STATUS_OWNER_EMAIL=
# A separate destination on another machine is optional and recommended.
BACKUP_SECONDARY_HOST_DIR=./backups/secondary
BACKUP_SECONDARY_DIR=
