# Gmail sender: use a Google app password, not your normal account password.
# Copy this file to .env; fill in the three empty values.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# SMTP_USER and MAIL_FROM: the same sending Gmail address.
# SMTP_PASS: the 16-character app password (without formatting spaces).
COOKIE_SECURE=false
# Local defaults only. Use deploy/production.env.example and compose.production.yml for HTTPS.
APP_ENV=development
APP_ORIGIN=
# Base Compose allows registration. Production override closes it for existing accounts only.
REGISTRATION_ENABLED=true
TRUST_CLOUDFLARE_PROXY=false

# Daily private backups (the primary directory is mounted separately from invoice-data).
BACKUP_HOST_DIR=./backups/automatic
BACKUP_RETENTION=14
# Set to the email of the account allowed to view backup status in Settings.
BACKUP_STATUS_OWNER_EMAIL=
# Optional mounted network/external destination; leave BACKUP_SECONDARY_DIR empty to disable.
BACKUP_SECONDARY_HOST_DIR=./backups/secondary
BACKUP_SECONDARY_DIR=
# When configuring the host destination, use BACKUP_SECONDARY_DIR=/app/secondary-backups.
